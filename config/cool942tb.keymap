#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp A  &kp B  &kp C  &kp D  &kp E  &kp F  &kp G  &kp H  &kp I  &kp J  &kp K
&kp L  &kp M  &kp N  &kp O  &kp P  &kp Q  &kp R  &kp S  &kp T  &kp U  &kp V
&kp W  &kp X  &kp Y  &kp Z  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7
&kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp SEMICOLON &kp SQT &kp COMMA &kp PERIOD
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };
    };
};
